PORT=4000
NODE_ENV=development

DATABASE_URL=""

REDIS_URL=""

RABBITMQ_URL=""

GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Gửi mail qua Gmail REST API (HTTPS 443, không bị Render free chặn như SMTP).
# Đủ 3 biến này thì dùng REST; thiếu thì fallback SMTP.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ALLOWED_ORIGINS=""
# URL Frontend để tạo link trong email (verify/reset password)
FRONTEND_URL="http://localhost:5173"
# Giới hạn request toàn API theo IP trong 15 phút (mặc định 600)
RATE_LIMIT_MAX=600
# Task dọn hold hết hạn chạy mỗi N ms (mặc định 43200000 = 12 giờ).
# Hold hết hạn vẫn bị từ chối/tính lại chỗ trống NGAY theo expiresAt;
# job này chỉ dọn row cũ, nên 12-24h là quá đủ. Chạy thường xuyên khiến
# Neon compute không ngủ, đốt CU-hrs của Neon free nhanh.
HOLD_CLEANUP_INTERVAL_MS=43200000